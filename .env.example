# =============================================================================
# TRANSPORTATION AGENT API KEYS
# =============================================================================

# Amadeus API (https://developers.amadeus.com/)
AMADEUS_API_KEY=your_amadeus_api_key
AMADEUS_API_SECRET=your_amadeus_api_secret

# Optional: RapidAPI for FlixBus
RAPIDAPI_KEY=your_rapidapi_key

# Optional: AllThingsDev for FlixBus alternative
ALLTHINGSDEV_API_KEY=your_allthingsdev_key

# =============================================================================
# ITINERARY GENERATOR AGENT API KEYS
# =============================================================================

# Serper API (required for place address search)
# Get free API key at: https://serper.dev
# Free tier: 2,500 searches to start
SERPER_API_KEY=your_serper_api_key

# Tavily API (required for web search and images)
# Get free API key at: https://app.tavily.com/
# Free tier: 1,000 searches/month
TAVILY_API_KEY=your_tavily_api_key

# Optional: Google Docs for document export
# Get credentials at: https://console.cloud.google.com/
# Follow guide: https://developers.google.com/docs/api/quickstart/python
GOOGLE_CREDENTIALS_PATH=path/to/your/credentials.json

# =============================================================================
# LLM PROVIDER (OpenRouter - Required)
# =============================================================================

# OpenRouter API key (required)
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your_openrouter_api_key

# Model Configuration
# You can set a different model for each agent, or use MODEL_NAME for both
# Browse models at: https://openrouter.ai/models

# First agent - organizes attractions into days (uses K-means clustering)
DAY_ORGANIZER_MODEL=anthropic/claude-sonnet-4-20250514

# Second agent - researches attraction details (runs in parallel per day)
ATTRACTION_RESEARCHER_MODEL=anthropic/claude-sonnet-4-20250514

# Fallback model (used if specific agent model not set)
MODEL_NAME=anthropic/claude-sonnet-4-20250514

# Other model examples:
# openai/gpt-4o
# google/gemini-pro-1.5
# x-ai/grok-3
# meta-llama/llama-3.1-405b-instruct

# =============================================================================
# MIDDLEWARE CONFIGURATION
# =============================================================================

# Structured output validation (optional - default: 3)
# Maximum retry attempts when structured output validation fails
STRUCTURED_OUTPUT_MAX_RETRIES=3

# =============================================================================
# EMAIL CONFIGURATION (Optional)
# =============================================================================

# SMTP_HOST= SMTP server host (e.g., smtp.gmail.com, smtp-mail.outlook.com)
# SMTP_PORT= SMTP server port (default: 587)
# SMTP_USER= SMTP username/email
# SMTP_PASS= SMTP password or app password

# =============================================================================
# OBSERVABILITY - LANGSMITH (Optional)
# =============================================================================

# LangSmith provides tracing, token usage, cost tracking, and debugging
# Sign up at: https://smith.langchain.com
# Get API key from: Settings > API Keys

# Enable tracing (set to "true" to enable)
LANGSMITH_TRACING=false

# Your LangSmith API key
# LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxx

# Project name for organizing traces (optional, defaults to "itinerary-generator")
# LANGSMITH_PROJECT=itinerary-generator

# LangSmith endpoint (optional, defaults to cloud)
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
